{
  "name": "memory",
  "version": "2.0.1",
  "description": "A simple memory game",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "pregenerate": "rimraf dist src/data/*.*",
