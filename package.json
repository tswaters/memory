{
  "name": "memory",
  "version": "1.3.0",
  "description": "A simple memory game",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "prebuild": "npm run prepare",
    "prepare": "rimraf dist var/*.json && npm run generate",
    "prestart": "npm run prepare",
    "build": "webpack --mode=production",
    "generate": "node ./emoji_data/index.mjs",
    "lint": "eslint .",
    "start": "webpack-dev-server --mode=development"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/tswaters/memory.git"
  },
  "keywords": [],
  "author": "Tyler Waters <tyler.waters@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.1.1",
    "classnames": "^2.2.6",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.5.0",
    "less": "^4.1.2",
    "less-loader": "^13.0.0",
    "mini-css-extract-plugin": "^2.4.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "webpack": "^5.65.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.5",
    "fireworks-canvas": "^2.4.0",
    "prop-types": "^15.7.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-redux": "^7.1.3",
    "redux": "^4.0.5",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^2.3.0",
    "reselect": "^4.0.0"
  },
  "babel": {
    "plugins": [
      "@babel/plugin-transform-runtime"
    ],
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ],
    "sourceMaps": true,
    "retainLines": true,
    "env": {
      "instrument": {
        "plugins": [
          "istanbul"
        ]
      }
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
